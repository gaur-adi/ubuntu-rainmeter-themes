{
  "id": "sonder",
  "name": "Sonder",
  "description": "Reference-based Ubuntu GNOME adaptation with live native widgets.",
  "engine": "native",
  "reference": {
    "creator": "Michael Purses",
    "source": "https://github.com/mpurses/Sonder",
    "preview": "https://raw.githubusercontent.com/mpurses/Sonder/master/Plugins/Screenshots/Sonder-v21.11.png",
    "checked": "2026-11-03",
    "fidelity": "Independent reference-based adaptation; not a pixel-identical or complete Windows suite port.",
    "notes": [
      "Includes the thin split-color clock, world map, calendar, five-day forecast and system meters.",
      "The geographic map uses public-domain Natural Earth data. The day/night shading is approximate; city-light overlays and the original audio visualizer are not included.",
      "Brightness/Bluetooth and wallpaper/settings menus remain available through GNOME\u2019s system controls."
    ]
  },
  "wallpaper": {
    "mode": "bundled",
    "file": "wallpaper.png",
    "sha256": "dd63b3488542238d40dcfa516f145877d1db954d76d159e4b5f636ddcab18eeb",
    "source": "../../docs/wallpaper-prompts.md",
    "credit": "Original AI-generated wallpaper created for this repository with OpenAI image_gen, 2026-11-03."
  },
